PORT=8000
SQLITE_PATH=./data/mail.sqlite
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000
# Generate with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))".
# Keep this key stable across restarts to decrypt saved mailbox credentials.
MAIL_ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:8000
# Generate a separate stable secret using the same command above.
APP_JWT_SECRET=
# Seed the initial administrator once. Pick a unique password of at least 12 characters.
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set these on the API server for live Jev classification.
# Example URL: https://YOUR-SITE.netlify.app/.netlify/functions/jev-classify
JEV_FUNCTION_URL=
# Generate an independent random secret and set the same value on the Netlify Function.
JEV_FUNCTION_SECRET=
# Optional comparison reference model.
GEMINI_API_KEY=
