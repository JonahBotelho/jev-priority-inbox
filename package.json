{
  "name": "jev-priority-inbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/main.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "demo:deliver": "tsx src/cli/deliver.ts",
    "compare": "tsx src/cli/compare.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@typesafe-ai/sdk": "0.7.0",
    "dotenv": "^17.0.0",
    "express": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
