MAIL_ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional offline model comparison.
JEV_API_KEY=
GEMINI_API_KEY=
