PORT=8000
# Server only. Use the pooled connection string from the Neon project's Connect dialog.
DATABASE_URL=
VITE_API_URL=http://localhost:8000
# Portal settings for the API service. Set the initial administrator pair to provision an admin.
CLIENT_ORIGIN=http://localhost:5173
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Optional externally managed signing key (at least 32 bytes). Otherwise the API persists a private random key in Neon.
APP_JWT_SECRET=

# Server-only settings for reviewing the public demo samples.
JEV_FUNCTION_URL=https://isa-term-project.netlify.app/.netlify/functions/jev-classify
# Generate an independent random secret and set the same value on the Netlify Function.
JEV_FUNCTION_SECRET=
# On the API service, set both to enable delivery to priority@ionooambea.resend.app.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional comparison reference model.
GEMINI_API_KEY=
